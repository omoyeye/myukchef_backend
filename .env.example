# Server
# Where uploaded images are kept (default: ./uploads) and where the built website is served from.
# UPLOAD_DIR=
# FRONTEND_DIST=../myukchef_frontend/dist
# Chefs' private certificate copies (default: ./private_uploads) and error logs (default: ./logs).
# PRIVATE_UPLOAD_DIR=
# LOG_DIR=
DATABASE_URL=mysql://user:password@localhost:3306/myukchef
PORT=3002
NODE_ENV=production
SITE_URL=https://myukchef.com
# If the website is on a different domain from this API, list it here (comma-separated).
# CORS_ORIGINS=https://www.myukchef.com
# This API's public address, shown to the Super Admin as the Stripe webhook address.
# API_URL=https://api.myukchef.com

# Required in production. Generate one with: openssl rand -hex 32
AUTH_SECRET=
# Encrypts the Stripe and Brevo keys saved in the admin area. Defaults to AUTH_SECRET.
# If you change it, those keys must be entered again.
# SECRETS_KEY=

# First admin account, used by: npm run db:seed
SEED_ADMIN_EMAIL=info@myukchef.com
SEED_ADMIN_PASSWORD=

# Stripe and Brevo keys are best entered by the Super Admin under Payments and email.
# Anything set there wins; these are only used for fields left empty there.

# Stripe card payments at checkout. With no secret key, orders are placed without payment.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo sends all email and SMS. Without a key, they are skipped and logged.
BREVO_API_KEY=
# MAIL_FROM must be a sender you've verified in Brevo.
MAIL_FROM=info@myukchef.com
SUPPORT_EMAIL=info@myukchef.com
BREVO_SMS_SENDER=MYUKCHEF

# Push notifications. Generate keys once with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@myukchef.com
# Phone app pushes go through Expo and work without a key. Add an Expo access token
# only if you turn on "enhanced push security" in your Expo account.
# EXPO_ACCESS_TOKEN=

# Google Maps. Enable Maps JavaScript API and Geocoding API.
# Server key: restrict by IP, used for postcode and address lookups.
GOOGLE_MAPS_API_KEY=

# AI recommendations (Vercel AI Gateway). Without a key, /recommend uses a simple ranking.
AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-opus-5.5
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
